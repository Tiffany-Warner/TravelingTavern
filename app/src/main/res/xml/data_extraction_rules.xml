<?xml version="1.0" encoding="utf-8"?><!--
   What Android Auto Backup may copy off the device (Android 12+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Nothing that connects the app to a server is backed up, so a fresh install always starts
   at Connect:
   - The credential keyset is wrapped by an Android Keystore key, and Keystore keys are never
     backed up: a restored keyset could not be unlocked
   - The settings DataStore holds the server address and the encrypted login. The login can't
     be decrypted after a restore anyway, and a restored address can be stale (a server's
     Tailscale IP can change), which left the app stuck on "Can't reach your server"
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tt_credentials_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tt_credentials_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
